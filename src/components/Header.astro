---
import { Image } from 'astro:assets';
import seal from '../assets/brand/seal.png';
import { studio } from '../lib/games';
import { url } from '../lib/url';

const links = [
  { href: url('/#games'), label: 'Games' },
  { href: url('/about/'), label: 'About' },
  // Dropped from the bar on phones (≤520px), where it doesn't fit; the footer links to it.
  { href: url('/press/'), label: 'Press', hidePhone: true },
];
---

<header class="header" data-header>
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label={`${studio.name} home`}>
      <Image src={seal} alt="" width={44} height={44} loading="eager" />
      <span class="wordmark">
        <span class="name">Brain Seal</span>
        <!-- One span per letter so the line can be spread to exactly the width of "Brain Seal" -->
        <small>{[...'Entertainment'].map((c) => <span>{c}</span>)}</small>
      </span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={{ 'hide-phone': l.hidePhone }}>{l.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]')!;
  const update = () => header.classList.toggle('solid', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
    background: linear-gradient(180deg, rgb(11 9 8 / 0.75), transparent);
  }
  .header.solid {
    background: rgb(11 9 8 / 0.88);
    backdrop-filter: blur(12px);
    border-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand img {
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 2px 8px rgb(179 25 31 / 0.5));
    transition: transform 0.4s;
  }
  .brand:hover img {
    transform: rotate(-12deg) scale(1.05);
  }
  .wordmark {
    --tracking: 0.14em;
    display: grid;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.3rem;
    line-height: 1.05;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    background: linear-gradient(180deg, var(--gold-hi), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .wordmark .name {
    /* Cancel the trailing letter-spacing so the right edge sits on the final L */
    margin-right: calc(-1 * var(--tracking));
  }
  .wordmark small {
    display: flex;
    justify-content: space-between;
    font-size: 0.5em;
    font-weight: 700;
    letter-spacing: 0;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
  }
  nav a {
    position: relative;
    font-family: var(--display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    padding-block: 8px;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.25s;
  }
  nav a:hover {
    color: var(--gold-hi);
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  @media (max-width: 520px) {
    .bar {
      height: 64px;
    }
    .brand img {
      width: 36px;
      height: 36px;
    }
    .wordmark {
      --tracking: 0.1em;
      font-size: 0.95rem;
      white-space: nowrap;
    }
    nav {
      gap: 14px;
    }
    nav a {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
    nav .hide-phone {
      display: none;
    }
  }
</style>
