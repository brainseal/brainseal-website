---
import { Image } from 'astro:assets';
import seal from '../assets/brand/seal.png';
import { url } from '../lib/url';

const links = [
  { href: url('/#games'), label: 'Games' },
  { href: url('/about/'), label: 'About' },
  { href: url('/#contact'), label: 'Contact', wide: true },
];
---

<header class="header" data-header>
  <div class="wrap bar">
    <a class="brand" href={url('/')}aria-label="Brain Seal home">
      <Image src={seal} alt="" width={44} height={44} loading="eager" />
      <span class="wordmark">Brain Seal</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={{ wide: l.wide }}>{l.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]')!;
  const update = () => header.classList.toggle('solid', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
    background: linear-gradient(180deg, rgb(11 9 8 / 0.75), transparent);
  }
  .header.solid {
    background: rgb(11 9 8 / 0.88);
    backdrop-filter: blur(12px);
    border-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand img {
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 2px 8px rgb(179 25 31 / 0.5));
    transition: transform 0.4s;
  }
  .brand:hover img {
    transform: rotate(-12deg) scale(1.05);
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.3rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: linear-gradient(180deg, var(--gold-hi), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  nav {
    display: flex;
    gap: clamp(16px, 3vw, 36px);
  }
  nav a {
    position: relative;
    font-family: var(--display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    padding-block: 8px;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.25s;
  }
  nav a:hover {
    color: var(--gold-hi);
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  @media (max-width: 520px) {
    .bar {
      height: 64px;
    }
    .brand img {
      width: 36px;
      height: 36px;
    }
    .wordmark {
      font-size: 1.05rem;
    }
    nav a {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }
    nav .wide {
      display: none;
    }
  }
</style>
