---
import { Image, getImage } from 'astro:assets';
import type { Game } from '../lib/games';

interface Props {
  game: Game;
  // One row of four (homepage) instead of the full gallery (game page).
  row?: boolean;
}

const { game, row = false } = Astro.props;

// The gallery always fills complete rows: 8 shows as 4×2; 6 or 7 as 3×2.
const count = game.shots.length;
const columns = row || count % 4 === 0 || count < 6 ? 4 : 3;
const shown = row ? 4 : count - (count % columns);
const shots = game.shots.slice(0, Math.max(shown, Math.min(count, 4)));
const full = await Promise.all(shots.map((s) => getImage({ src: s, width: 1920 })));
---

<div class="shots" style={`--columns: ${columns}`}>
  {
    shots.map((shot, i) => (
      <a href={full[i].src} data-shot>
        <Image
          src={shot}
          alt={`${game.title} screenshot ${i + 1}`}
          widths={[400, 640]}
          sizes={`(max-width: 700px) 50vw, ${Math.round(100 / columns)}vw`}
        />
      </a>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox>
  <img alt="" />
  <button type="button" aria-label="Close">×</button>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-lightbox]').forEach((dialog) => {
    const img = dialog.querySelector('img')!;
    dialog.previousElementSibling!.querySelectorAll<HTMLAnchorElement>('[data-shot]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', () => dialog.close());
  });
</script>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 12px;
  }
  .shots a {
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
  }
  .shots :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .shots a:hover :global(img) {
    transform: scale(1.04);
  }
  .lightbox {
    max-width: min(1600px, 96vw);
    padding: 0;
    border: 1px solid var(--line);
    background: #000;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  .lightbox img {
    max-height: 90vh;
    width: auto;
  }
  .lightbox button {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 44px;
    height: 44px;
    border: 0;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 1.8rem;
    cursor: pointer;
  }
  @media (max-width: 700px) {
    .shots {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
</style>
