---
import { Image } from 'astro:assets';
import seal from '../assets/brand/seal.png';
import { studio } from '../lib/games';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="wrap">
    <div class="call">
      <Image src={seal} alt="" width={96} height={96} class="seal" />
      <h2>Join the legion</h2>
      <p>Talk tactics with the community on Discord, or send word to the studio for business, press and publishing.</p>
      <div class="btn-row center">
        <a class="btn btn-discord" href={studio.discord} rel="noopener">
          <!-- Discord logo, from Simple Icons (CC0) -->
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
            ></path>
          </svg>
          Join our Discord
        </a>
        <a class="btn btn-gold" href={`mailto:${studio.email}`}>{studio.email}</a>
      </div>
      <ul class="socials" aria-label={`Follow ${studio.name}`}>
        {studio.socials.map((s) => (
          <li>
            <a href={s.url} rel="noopener">{s.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="legal">
      <span>© {year} {studio.legalName}. All rights reserved.</span>
      <span>
        Player support: <a href={`mailto:${studio.supportEmail}`}>{studio.supportEmail}</a> · <a href={url('/press/')}>Press kit</a> ·
        <a href={url('/privacy-policy/')}>Privacy policy</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 80% at 50% 0%, rgb(179 25 31 / 0.22), transparent 70%),
      var(--ink-2);
    padding-top: clamp(64px, 9vw, 112px);
  }
  .call {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .seal {
    width: 96px;
    height: 96px;
    filter: drop-shadow(0 8px 24px rgb(179 25 31 / 0.55));
  }
  h2 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    text-transform: uppercase;
    background: linear-gradient(180deg, var(--gold-hi), var(--gold) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .call p {
    color: var(--muted);
    margin: 0;
  }
  .center {
    justify-content: center;
    margin-top: 8px;
  }
  .center .btn {
    text-transform: none;
    letter-spacing: 0.06em;
  }
  /* Discord's own brand colour, so the button reads as Discord at a glance */
  .btn-discord {
    --btn-bg: #5865f2;
    --btn-fg: #fff;
    --btn-line: #5865f2;
    box-shadow: 0 10px 30px -10px rgb(88 101 242 / 0.6);
  }
  .btn-discord:hover {
    color: #fff;
    border-color: #8891f7;
    filter: brightness(1.08);
  }
  .btn-discord svg {
    width: 1.35em;
    height: 1.35em;
    fill: currentColor;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .socials a {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  .socials a:hover {
    color: var(--gold-hi);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .legal a {
    color: var(--text);
  }
  .legal a:hover {
    color: var(--gold-hi);
  }
</style>
