---
import { Image } from 'astro:assets';
import seal from '../assets/brand/seal.png';
import { studio } from '../lib/games';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="wrap">
    <div class="call">
      <Image src={seal} alt="" width={96} height={96} class="seal" />
      <h2>Join the legion</h2>
      <p>Business, press or publishing enquiries: we read everything.</p>
      <div class="btn-row center">
        <a class="btn btn-gold" href={`mailto:${studio.email}`}>{studio.email}</a>
      </div>
      <ul class="socials" aria-label="Follow Brain Seal">
        {studio.socials.map((s) => (
          <li>
            <a href={s.url} rel="noopener">{s.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="legal">
      <span>© {year} Brain Seal Ltd. All rights reserved.</span>
      <span>
        Player support: <a href={`mailto:${studio.supportEmail}`}>{studio.supportEmail}</a> · <a href={url('/privacy-policy/')}>Privacy policy</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 80% at 50% 0%, rgb(179 25 31 / 0.22), transparent 70%),
      var(--ink-2);
    padding-top: clamp(64px, 9vw, 112px);
  }
  .call {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
  }
  .seal {
    width: 96px;
    height: 96px;
    filter: drop-shadow(0 8px 24px rgb(179 25 31 / 0.55));
  }
  h2 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    text-transform: uppercase;
    background: linear-gradient(180deg, var(--gold-hi), var(--gold) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .call p {
    color: var(--muted);
    margin: 0;
  }
  .center {
    justify-content: center;
    margin-top: 8px;
  }
  .center .btn {
    text-transform: none;
    letter-spacing: 0.06em;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .socials a {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  .socials a:hover {
    color: var(--gold-hi);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .legal a {
    color: var(--text);
  }
  .legal a:hover {
    color: var(--gold-hi);
  }
</style>
