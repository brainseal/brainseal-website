---
import { PLATFORMS, type Platform } from '../lib/games';
import { ICONS } from '../lib/icons';

const PATHS: Record<Platform, string> = ICONS;

interface Props {
  platform: Platform;
  // Set when the platform name is already written next to the icon.
  decorative?: boolean;
}

const { platform, decorative = false } = Astro.props;
---

{
  decorative ? (
    <svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d={PATHS[platform]} />
    </svg>
  ) : (
    <svg class="platform-icon" viewBox="0 0 24 24" role="img" aria-label={PLATFORMS[platform]}>
      <title>{PLATFORMS[platform]}</title>
      <path d={PATHS[platform]} />
    </svg>
  )
}

<style>
  .platform-icon {
    width: 1em;
    height: 1em;
    flex: none;
    fill: currentColor;
  }
</style>
