---
import PlatformIcon from './PlatformIcon.astro';
import { PLATFORMS, platformsOf, type Game } from '../lib/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<ul class="platform-links">
  {
    platformsOf(game).map((p) => (
      <li>
        {game.stores[p] ? (
          <a href={game.stores[p]} rel="noopener">
            <PlatformIcon platform={p} decorative />
            <span>{PLATFORMS[p]}</span>
          </a>
        ) : (
          <span class="tile">
            <PlatformIcon platform={p} decorative />
            <span>{PLATFORMS[p]}</span>
          </span>
        )}
      </li>
    ))
  }
</ul>

<style>
  .platform-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a,
  .tile {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 18px;
    border: 1px solid var(--line);
    background: var(--ink-2);
    color: var(--gold);
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .platform-links :global(.platform-icon) {
    font-size: 22px;
  }
  a:hover {
    color: var(--gold-hi);
    border-color: var(--gold);
  }
</style>
