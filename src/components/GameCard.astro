---
import { Image } from 'astro:assets';
import { PLATFORMS, platformsOf, type Game } from '../lib/games';
import { url } from '../lib/url';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<a class="card" href={url(`/games/${game.slug}/`)} style={`--accent: ${game.accent}`}>
  <div class="art">
    <Image src={game.cover} alt={`${game.title} cover art`} widths={[300, 450, 600]} sizes="(max-width: 600px) 50vw, 300px" />
    {game.upcoming && <span class="ribbon">Coming soon</span>}
  </div>
  <div class="meta">
    <h3>{game.title}</h3>
    <p>{game.year} · {platformsOf(game).map((p) => PLATFORMS[p].replace('Nintendo ', '')).join(' · ')}</p>
  </div>
</a>

<style>
  .card {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }
  .art {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-3);
    transition: transform 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(11 9 8 / 0.65));
    opacity: 0;
    transition: opacity 0.35s;
  }
  .card:hover .art {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 24px 50px -20px var(--accent);
  }
  .card:hover .art :global(img) {
    transform: scale(1.05);
  }
  .card:hover .art::after {
    opacity: 1;
  }
  .ribbon {
    position: absolute;
    top: 14px;
    left: -1px;
    z-index: 1;
    padding: 6px 14px 6px 12px;
    background: var(--crimson);
    color: #fff;
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 50%, 100% 100%, 0 100%);
  }
  h3 {
    font-size: 1.15rem;
    text-transform: uppercase;
    transition: color 0.25s;
  }
  .card:hover h3 {
    color: var(--gold-hi);
  }
  .meta p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
</style>
