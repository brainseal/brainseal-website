---
import { Image } from 'astro:assets';
import { PLATFORMS, platformsOf, type Game } from '../lib/games';
import { url } from '../lib/url';
import PlatformIcon from './PlatformIcon.astro';
interface Props {
  game: Game;
}

const { game } = Astro.props;
// Ghost games have no page yet, so their card is a plain, dimmed tile instead of a link.
const Card = game.ghost ? 'div' : 'a';
---

<Card
  class:list={['card', { ghost: game.ghost }]}
  href={game.ghost ? undefined : url(`/games/${game.slug}/`)}
  style={`--accent: ${game.accent}`}>
  <div class="art">
    <Image src={game.cover} alt={`${game.title} cover art`} widths={[300, 450, 600]} sizes="(max-width: 600px) 50vw, 300px" />
    {game.upcoming && <span class="ribbon">Coming soon</span>}
  </div>
  <div class="meta">
    <h3>{game.title}</h3>
    <p>{game.upcoming ? `Coming ${game.year}` : game.year}</p>
    <ul class="platforms" aria-label="Platforms">
      {
        platformsOf(game).map((p) => (
          <li title={PLATFORMS[p]}>
            <PlatformIcon platform={p} />
          </li>
        ))
      }
    </ul>
  </div>
</Card>

<style>
  .card {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }
  .art {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-3);
    transition: transform 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  /* Ghost: a faded, greyed tile that can't be clicked */
  .ghost {
    cursor: default;
  }
  .ghost .art :global(img) {
    filter: grayscale(0.85) brightness(0.55);
  }
  .ghost .meta {
    opacity: 0.5;
  }
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(11 9 8 / 0.65));
    opacity: 0;
    transition: opacity 0.35s;
  }
  a.card:hover .art {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 24px 50px -20px var(--accent);
  }
  a.card:hover .art :global(img) {
    transform: scale(1.05);
  }
  a.card:hover .art::after {
    opacity: 1;
  }
  .ribbon {
    position: absolute;
    top: 14px;
    left: -1px;
    z-index: 1;
    padding: 6px 14px 6px 12px;
    background: var(--crimson);
    color: #fff;
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 50%, 100% 100%, 0 100%);
  }
  h3 {
    font-size: 1.15rem;
    text-transform: uppercase;
    transition: color 0.25s;
  }
  a.card:hover h3 {
    color: var(--gold-hi);
  }
  .meta p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .platforms li {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    background: var(--ink-2);
    color: var(--gold);
    font-size: 15px;
    transition: color 0.25s, border-color 0.25s;
  }
  a.card:hover .platforms li {
    color: var(--gold-hi);
    border-color: rgb(212 162 76 / 0.4);
  }
</style>
