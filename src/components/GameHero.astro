---
import { Image } from 'astro:assets';
import StoreButtons from './StoreButtons.astro';
import ReviewBadge from './ReviewBadge.astro';
import { formatDate, type Game } from '../lib/games';
import { url } from '../lib/url';

interface Props {
  game: Game;
  eyebrow?: string;
  heading?: 'h1' | 'h2';
  link?: boolean;
}

const { game, eyebrow, heading: Heading = 'h1', link = false } = Astro.props;
const status = game.upcoming
  ? `Launches ${formatDate(game.releaseDate)}`
  : `Out now · Released ${game.year}`;
const countdown = game.upcoming && game.hasLaunchTime;
const units = [
  ['d', 'Days'],
  ['h', 'Hours'],
  ['m', 'Minutes'],
  ['s', 'Seconds'],
];
---

<section
  class:list={['hero', { 'art-logo': game.heroHasLogo }]}
  style={`--accent: ${game.accent}`}
  data-launch={countdown ? game.releaseDate.toISOString() : undefined}>
  <Image
    class="bg"
    src={game.hero}
    alt={game.heroHasLogo ? `${game.title} key art` : ''}
    widths={[960, 1600, 2400, 3200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap content">
    <div class="lead">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <Heading class:list={['title', { 'visually-hidden': game.heroHasLogo }]}>
        {
          game.logo && !game.heroHasLogo ? (
            <Image src={game.logo} alt={game.title} widths={[480, 720]} sizes="(max-width: 600px) 80vw, 520px" loading="eager" />
          ) : (
            game.title
          )
        }
      </Heading>
      <p class="status"><span class="dot"></span><span data-status>{status}</span></p>
      {
        countdown && (
          <div class="countdown" data-countdown hidden>
            {units.map(([unit, label]) => (
              <div>
                <span data-unit={unit}>00</span>
                <small>{label}</small>
              </div>
            ))}
          </div>
        )
      }
      {
        game.heroHasLogo ? (
          <>
            <StoreButtons game={game} primaryOnly />
            {game.review && <ReviewBadge review={game.review} />}
          </>
        ) : (
          <>
            <p class="tagline">{game.tagline}</p>
            <p class="summary">{game.summary}</p>
          </>
        )
      }
    </div>
    {
      (!game.heroHasLogo || link) && (
        <div class="actions">
          {!game.heroHasLogo && game.review && <ReviewBadge review={game.review} />}
          {!game.heroHasLogo && <StoreButtons game={game} />}
          {link && <a class="more" href={url(`/games/${game.slug}/`)}>Enter the arena →</a>}
        </div>
      )
    }
  </div>
</section>

<script>
  // Live countdown to launch. The page is built ahead of time, so when the clock runs out
  // it flips to "Out now" here; the nightly rebuild then makes that permanent.
  document.querySelectorAll<HTMLElement>('[data-launch]').forEach((hero) => {
    const launch = Date.parse(hero.dataset.launch!);
    const box = hero.querySelector<HTMLElement>('[data-countdown]')!;
    const cells = Object.fromEntries(
      [...box.querySelectorAll<HTMLElement>('[data-unit]')].map((el) => [el.dataset.unit!, el]),
    );
    const tick = () => {
      const left = launch - Date.now();
      if (left <= 0) {
        clearInterval(timer);
        box.hidden = true;
        hero.querySelector('[data-status]')!.textContent = 'Out now';
        hero.querySelectorAll('[data-wishlist]').forEach((a) => (a.textContent = 'Buy on Steam'));
        return;
      }
      const s = Math.floor(left / 1000);
      const parts = { d: Math.floor(s / 86400), h: Math.floor(s / 3600) % 24, m: Math.floor(s / 60) % 60, s: s % 60 };
      for (const [unit, value] of Object.entries(parts)) cells[unit].textContent = String(value).padStart(2, '0');
      box.hidden = false;
    };
    const timer = setInterval(tick, 1000);
    tick();
  });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(100svh, 1000px);
    padding-block: 140px clamp(56px, 9vw, 112px);
    isolation: isolate;
    overflow: hidden;
  }
  .hero :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    animation: drift 24s ease-out both;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(11 9 8 / 0.92) 0%, rgb(11 9 8 / 0.65) 40%, rgb(11 9 8 / 0.1) 75%),
      linear-gradient(0deg, var(--ink) 0%, rgb(11 9 8 / 0.4) 35%, transparent 60%);
  }
  .content,
  .lead,
  .actions {
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .lead > *,
  .actions > * {
    max-width: 620px;
  }
  /* Key art with the logo painted in: keep the art clear and put the details in a bar along the bottom. */
  .art-logo :global(.bg) {
    object-position: 50% 0%;
  }
  .art-logo::before {
    background:
      linear-gradient(0deg, var(--ink) 0%, rgb(11 9 8 / 0.88) 20%, rgb(11 9 8 / 0.4) 36%, transparent 50%),
      linear-gradient(180deg, rgb(11 9 8 / 0.5), transparent 18%);
  }
  .art-logo {
    padding-bottom: clamp(32px, 4vw, 48px);
  }
  /* A compact block on the left, its lines centred on each other, with one wide call to action. */
  .art-logo .lead,
  .art-logo .actions {
    justify-items: center;
    text-align: center;
  }
  .art-logo .lead {
    gap: 12px;
  }
  .art-logo .eyebrow::after {
    content: '';
    width: 2.2em;
    height: 1px;
    background: currentColor;
  }
  .art-logo .lead :global(.btn-row) {
    justify-content: center;
    width: 100%;
    margin-top: 6px;
  }
  .art-logo .lead :global(.btn) {
    width: min(100%, 344px);
    min-height: 58px;
    font-size: 1rem;
  }
  .title {
    font-size: clamp(2.8rem, 8vw, 5.6rem);
    text-transform: uppercase;
    background: linear-gradient(180deg, #fff3d6, var(--gold-hi) 40%, var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 4px 24px rgb(0 0 0 / 0.7));
  }
  .title :global(img) {
    width: min(520px, 80vw);
    max-height: 260px;
    object-fit: contain;
    object-position: left center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 0;
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--gold-hi);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--crimson-hi);
    box-shadow: 0 0 0 4px rgb(217 42 47 / 0.25);
    animation: pulse 2s infinite;
  }
  .countdown {
    display: flex;
    gap: 10px;
    margin: 4px 0 6px;
  }
  .countdown[hidden] {
    display: none;
  }
  .countdown div {
    display: grid;
    justify-items: center;
    min-width: 76px;
    padding: 10px 8px 8px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--crimson-hi);
    background: rgb(11 9 8 / 0.6);
    backdrop-filter: blur(6px);
  }
  .countdown span {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #fff3d6, var(--gold-hi) 45%, var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .countdown small {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .tagline {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }
  .summary {
    margin: 0 0 12px;
    color: #d8cfc1;
  }
  .more {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--gold);
    text-decoration: none;
    margin-top: 4px;
  }
  .more:hover {
    color: var(--gold-hi);
  }
  @keyframes drift {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 8px rgb(217 42 47 / 0);
    }
  }
  @media (max-width: 720px) {
    .hero {
      min-height: 92svh;
    }
    .countdown {
      gap: 6px;
    }
    .countdown div {
      min-width: 0;
      flex: 1;
      max-width: 76px;
    }
    .hero :global(.bg) {
      object-position: 60% 30%;
    }
    .hero::before {
      background: linear-gradient(0deg, var(--ink) 0%, rgb(11 9 8 / 0.8) 45%, rgb(11 9 8 / 0.25) 100%);
    }
  }
  /* In windows narrower than 4:3, filling the screen would crop the painted logo at the sides,
     so show the whole artwork with the details underneath instead. */
  @media (max-aspect-ratio: 4/3) {
    .art-logo {
      display: block;
      min-height: 0;
      padding-top: 72px;
    }
    .art-logo :global(.bg) {
      position: relative;
      z-index: auto;
      height: auto;
      aspect-ratio: 16 / 9;
      object-position: 50% 50%;
      animation: none;
    }
    .art-logo::before {
      display: none;
    }
    .art-logo .content {
      padding-top: 24px;
    }
  }
</style>
