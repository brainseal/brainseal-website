---
import { PLATFORMS, platformsOf, type Game } from '../lib/games';

interface Props {
  game: Game;
  // Only the main store button (the first platform), for tight spots like the logo-art hero.
  primaryOnly?: boolean;
}

const { game, primaryOnly = false } = Astro.props;
const platforms = platformsOf(game)
  .filter((p) => game.stores[p])
  .slice(0, primaryOnly ? 1 : undefined);
---

<div class="btn-row">
  {
    platforms.map((p, i) => (
      <a
        class:list={['btn', { 'btn-primary': i === 0 }]}
        href={game.stores[p]}
        rel="noopener"
        data-wishlist={p === 'steam' && game.upcoming ? '' : undefined}>
        {p === 'steam' ? (game.upcoming ? 'Wishlist on Steam' : 'Buy on Steam') : PLATFORMS[p]}
      </a>
    ))
  }
</div>
