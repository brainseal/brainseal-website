---
import Base from '../../layouts/Base.astro';
import GameHero from '../../components/GameHero.astro';
import GameCard from '../../components/GameCard.astro';
import Trailer from '../../components/Trailer.astro';
import Screenshots from '../../components/Screenshots.astro';
import { games, PLATFORMS, platformsOf, studio, type Game } from '../../lib/games';
import aboutText from '../../data/about.json';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const platforms = platformsOf(game).map((p) => PLATFORMS[p]);
const others = games.filter((g) => g.slug !== game.slug).slice(0, 4);

// The game's "About this game" text from its Steam page (npm run fetch-about); falls back to the
// short description in games.json when a game has none.
type Block = { heading: string } | { text: string } | { list: string[] };
const story = ((aboutText as Record<string, Block[]>)[game.slug] ?? []) as Block[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  description: game.summary,
  url: new URL(url(`/games/${game.slug}/`), Astro.site).href,
  datePublished: game.released,
  genre: game.genres,
  gamePlatform: platforms,
  author: { '@type': 'Organization', name: studio.name, legalName: studio.legalName, url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: game.publisher ?? studio.name },
  trailer: { '@type': 'VideoObject', name: `${game.title} trailer`, embedUrl: `https://www.youtube.com/embed/${game.youtube}` },
};
---

<Base title={game.title} description={game.summary} image={game.hero} jsonLd={jsonLd}>
  <GameHero game={game} eyebrow={game.upcoming ? 'Coming Soon!' : 'Available Now!'} launchedEyebrow="Available Now!" tiles />

  <!-- Pitch, then the trailer at full stage width -->
  <section class="section intro" style={`--accent: ${game.accent}`}>
    <div class="wrap stage">
      {game.logline && <p class="logline">{game.logline}</p>}
      <div id="trailer">
        <Trailer id={game.youtube} title={game.title} poster={game.shots[0] ?? game.hero} />
      </div>
    </div>
  </section>

  <!-- The game's story and its screenshots share one panel -->
  <section class="section shots-section">
    <div class="wrap">
      <div class="about">
      {
        story.length > 0 ? (
          story.map((b) =>
            'heading' in b ? (
              <h3>{b.heading}</h3>
            ) : 'list' in b ? (
              <ul>
                {b.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>{b.text}</p>
            ),
          )
        ) : (
          <>
            {game.heroHasLogo && <h3>{game.tagline}</h3>}
            {game.heroHasLogo && <p>{game.summary}</p>}
            {game.description.map((p) => <p>{p}</p>)}
          </>
        )
      }
      </div>
      {game.shots.length > 0 && <Screenshots game={game} />}
    </div>
  </section>

  <section class="section more">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">More from Brain Seal</span>
      </div>
      <div class="more-grid">
        {others.map((g) => <GameCard game={g} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(16px, 3vw, 40px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .stage {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    max-width: 1180px;
  }
  /* A reading column centred in the panel, above the screenshots; long text and lists read best left-aligned. */
  .about {
    max-width: 780px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    font-size: 1.1rem;
    color: #ddd4c6;
  }
  .about > :first-child {
    margin-top: 0;
  }
  .about h3 {
    margin: 1.8em 0 0.6em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    text-transform: uppercase;
    color: var(--gold-hi);
  }
  .about ul {
    margin: 0 0 1em;
    padding-left: 1.3em;
  }
  .about li {
    margin-bottom: 0.4em;
  }
  .about li::marker {
    color: var(--gold);
  }
  .shots-section {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
  }
  /* Same width as the trailer so the edges line up */
  .shots-section .wrap {
    max-width: 1180px;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2.5vw, 32px);
  }
  @media (max-width: 960px) {
    .more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
