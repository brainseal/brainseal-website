---
import Base from '../../layouts/Base.astro';
import GameHero from '../../components/GameHero.astro';
import GameCard from '../../components/GameCard.astro';
import Trailer from '../../components/Trailer.astro';
import Screenshots from '../../components/Screenshots.astro';
import PlatformLinks from '../../components/PlatformLinks.astro';
import { games, formatDate, PLATFORMS, platformsOf, studio, type Game } from '../../lib/games';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const platforms = platformsOf(game).map((p) => PLATFORMS[p]);
const others = games.filter((g) => g.slug !== game.slug).slice(0, 4);

const facts = [
  { label: game.upcoming ? 'Release date' : 'Released', value: formatDate(game.releaseDate) },
  { label: 'Genre', value: game.genres.join(', ') },
  { label: 'Platforms', value: platforms.join(', ') },
  { label: 'Developer', value: studio.name },
  { label: 'Publisher', value: game.publisher ?? studio.name },
  ...(game.review ? [{ label: 'Steam reviews', value: `${game.review.label} · ${game.review.percent}% of ${game.review.count.toLocaleString('en-GB')}` }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  description: game.summary,
  url: new URL(url(`/games/${game.slug}/`), Astro.site).href,
  datePublished: game.released,
  genre: game.genres,
  gamePlatform: platforms,
  author: { '@type': 'Organization', name: studio.name, legalName: studio.legalName, url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: game.publisher ?? studio.name },
  trailer: { '@type': 'VideoObject', name: `${game.title} trailer`, embedUrl: `https://www.youtube.com/embed/${game.youtube}` },
};
---

<Base title={game.title} description={game.summary} image={game.hero} jsonLd={jsonLd}>
  <GameHero game={game} eyebrow="A Brain Seal Entertainment game" />

  <section class="section body" style={`--accent: ${game.accent}`}>
    <div class="wrap layout">
      <div class="main">
        <div id="trailer">
          <Trailer id={game.youtube} title={game.title} poster={game.shots[0] ?? game.hero} />
        </div>
        <div class="about">
          <span class="eyebrow">The game</span>
          {game.heroHasLogo && <p>{game.summary}</p>}
          {game.description.map((p) => <p>{p}</p>)}
          {/* The logo-art hero only carries the main store button, so list every platform here. */}
          {game.heroHasLogo && <div class="platforms"><PlatformLinks game={game} /></div>}
        </div>
      </div>
      <aside class="facts">
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  {
    game.shots.length > 0 && (
      <section class="section shots-section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Screenshots</span>
          </div>
          <Screenshots game={game} />
        </div>
      </section>
    )
  }

  <section class="section more">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">More from Brain Seal</span>
      </div>
      <div class="more-grid">
        {others.map((g) => <GameCard game={g} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .body {
    padding-top: 0;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .main {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
  }
  .about {
    display: grid;
    gap: 4px;
    font-size: 1.1rem;
    color: #ddd4c6;
  }
  .about .eyebrow {
    margin-bottom: 12px;
  }
  .about .platforms {
    margin-top: 12px;
  }
  .facts {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 24px;
  }
  dl {
    margin: 0;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    background: var(--ink-2);
  }
  dl div {
    padding: 14px 20px;
  }
  dl div + div {
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .shots-section {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2.5vw, 32px);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .facts {
      position: static;
    }
    .more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
