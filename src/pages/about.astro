---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import StudioStory from '../components/StudioStory.astro';
import { games } from '../lib/games';
---

<Base title="About" description="Founded in 2007, Brain Seal is an independent video game developer and publisher based in the United Kingdom, with games on Steam, PlayStation, Xbox and Nintendo Switch.">
  <PageHeader eyebrow="About the studio" title="We are Brain Seal" />

  <section class="section">
    <div class="wrap story">
      <div>
        <h2>Small Studio. Big Adventures.</h2>
        <StudioStory />
      </div>
      <div class="covers" aria-hidden="true">
        {games.slice(0, 6).map((g) => <Image src={g.cover} alt="" widths={[200, 300]} sizes="160px" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .story h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .story :global(p) {
    color: #d8cfc1;
    font-size: 1.1rem;
  }
  .covers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    transform: rotate(-3deg);
  }
  .covers :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .covers :global(img:nth-child(3n + 2)) {
    transform: translateY(24px);
  }
  @media (max-width: 800px) {
    .story {
      grid-template-columns: 1fr;
    }
    .covers {
      transform: none;
    }
  }
</style>
