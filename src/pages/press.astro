---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import seal from '../assets/brand/seal.png';
import { games, studio, formatDate, PLATFORMS, platformsOf, totalReviews } from '../lib/games';
import { url } from '../lib/url';

const facts = [
  { label: 'Studio', value: studio.name },
  { label: 'Company', value: studio.legalName },
  { label: 'Based in', value: studio.location },
  { label: 'Founded', value: `${studio.founded}` },
  { label: 'First release', value: `${studio.firstGame.title}, ${studio.firstGame.year}` },
  { label: 'Games', value: `${games.length}` },
  { label: 'Platforms', value: Object.values(PLATFORMS).join(', ') },
  ...(totalReviews > 0 ? [{ label: 'Steam reviews', value: totalReviews.toLocaleString('en-GB') }] : []),
];

// Download links point at the original, full-resolution files.
const downloads = (game: (typeof games)[number]) => [
  { label: 'Key art', href: game.hero.src },
  ...(game.logo ? [{ label: 'Logo', href: game.logo.src }] : []),
  { label: 'Cover', href: game.cover.src },
];
---

<Base title="Press kit" description={`Fact sheet, logos, key art and screenshots for ${studio.name} and its games.`}>
  <PageHeader eyebrow="Press kit" title="Press & creators">
    <p>Everything you need to write about, stream or feature our games: the studio fact sheet, logo, key art and screenshots.</p>
    <div class="btn-row">
      <a class="btn btn-gold" href={`mailto:${studio.email}`}>{studio.email}</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="wrap studio">
      <div>
        <h2>The studio</h2>
        <p>
          {studio.name} is an independent video game developer and publisher based in London.{' '}
          {`Since ${studio.firstGame.title} in ${studio.firstGame.year}`}, the studio has released {games.filter((g) => !g.upcoming).length} games across
          {' '}{Object.values(PLATFORMS).slice(0, -1).join(', ')} and {Object.values(PLATFORMS).at(-1)}, from the HeroQuest-inspired Dark
          Quest saga to gladiator epics, strategy and physics games.
        </p>
        <p>For interviews, review copies or anything else, email <a href={`mailto:${studio.email}`}>{studio.email}</a>.</p>
        <div class="logo-card">
          <Image src={seal} alt={`${studio.name} seal logo`} width={120} height={120} />
          <div>
            <strong>Studio logo</strong>
            <span>PNG, transparent, {seal.width}×{seal.height}</span>
            <a href={seal.src} download="brain-seal-logo.png">Download</a>
          </div>
        </div>
      </div>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section games">
    <div class="wrap">
      <div class="section-head assets-head">
        <h2>Game Assets</h2>
      </div>
      <ul class="kit">
        {
          games.map((game) => (
            <li style={`--accent: ${game.accent}`}>
              <Image src={game.cover} alt="" widths={[160, 240]} sizes="120px" />
              <div class="info">
                <h3>{game.ghost ? game.title : <a href={url(`/games/${game.slug}/`)}>{game.title}</a>}</h3>
                <p>
                  {game.upcoming ? `Launches ${formatDate(game.releaseDate)}` : `Released ${game.releasedLabel}`} ·{' '}
                  {(game.formerPlatforms ?? platformsOf(game).map((p) => PLATFORMS[p])).join(', ')}
                </p>
                <p class="genres">{game.genres.join(' · ')}</p>
                <ul class="files">
                  {downloads(game).map((d) => (
                    <li>
                      <a href={d.href} download={`${game.slug}-${d.label.toLowerCase().replace(/\s+/g, '-')}`}>{d.label}</a>
                    </li>
                  ))}
                  {game.shots.length > 0 && (
                    <li class="shots">
                      Screenshots
                      {game.shots.map((s, i) => (
                        <a href={s.src} download={`${game.slug}-screenshot-${i + 1}`} aria-label={`Screenshot ${i + 1}`}>
                          {i + 1}
                        </a>
                      ))}
                    </li>
                  )}
                  <li>
                    <a href={`https://www.youtube.com/watch?v=${game.youtube}`} rel="noopener">Trailer</a>
                  </li>
                  {game.stores.steam && (
                    <li>
                      <a href={game.stores.steam} rel="noopener">Steam page</a>
                    </li>
                  )}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .studio {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .studio h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .studio p {
    color: #d8cfc1;
  }
  .studio p a {
    color: var(--gold-hi);
  }
  .logo-card {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--line);
    background: var(--ink-2);
  }
  .logo-card :global(img) {
    width: 96px;
    height: 96px;
  }
  .logo-card div {
    display: grid;
    gap: 2px;
  }
  .logo-card strong {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .logo-card span {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .logo-card a,
  .files a {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
  }
  .logo-card a:hover,
  .files a:hover {
    color: var(--gold-hi);
    text-decoration: underline;
  }
  .facts {
    margin: 0;
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    background: var(--ink-2);
  }
  .facts div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding: 12px 20px;
  }
  .facts div + div {
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .assets-head {
    justify-items: center;
    text-align: center;
  }
  .games {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
  }
  .kit {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kit > li {
    display: flex;
    gap: 20px;
    padding: 18px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: var(--ink);
  }
  .kit > li > :global(img) {
    width: 96px;
    height: 144px;
    flex: none;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  /* Let the text column shrink beside the cover on narrow phones instead of pushing the page wider */
  .info {
    min-width: 0;
  }
  .info h3 {
    font-size: 1.15rem;
    text-transform: uppercase;
  }
  .info h3 a {
    text-decoration: none;
  }
  .info h3 a:hover {
    color: var(--gold-hi);
  }
  .info p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .genres {
    font-size: 0.78rem !important;
    letter-spacing: 0.06em;
  }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }
  .files .shots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    color: var(--muted);
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 800px) {
    .studio {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 460px) {
    .kit > li > :global(img) {
      width: 72px;
      height: 108px;
    }
    .facts div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
