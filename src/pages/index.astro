---
import Base from '../layouts/Base.astro';
import GameHero from '../components/GameHero.astro';
import GameCard from '../components/GameCard.astro';
import Trailer from '../components/Trailer.astro';
import Showcase from '../components/Showcase.astro';
import Screenshots from '../components/Screenshots.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import StudioStory from '../components/StudioStory.astro';
import { games, featured, studio } from '../lib/games';

// Optional full-screen bands for games flagged `"showcase": true` in games.json (none right now).
// The featured game is chapter I; showcased games follow in release order.
const NUMERALS = ['II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const showcase = games.filter((g) => g.showcase && g !== featured);
---

<Base>
  <h1 class="visually-hidden">{studio.name}: video game developer and publisher</h1>
  <GameHero game={featured} heading="h2" eyebrow={featured.upcoming ? 'New from Brain Seal' : 'Latest from Brain Seal'} />

  <section class="section featured" style={`--accent: ${featured.accent}`} aria-label={featured.title}>
    <div class="wrap">
      <div class="feature">
        <Trailer id={featured.youtube} title={featured.title} poster={featured.shots[0] ?? featured.hero} />
        <div class="pitch">
          <h2>{featured.tagline}</h2>
          {featured.description.map((p) => <p>{p}</p>)}
        </div>
      </div>
      {featured.logline && <p class="logline">{featured.logline}</p>}
      {featured.shots.length > 0 && <Screenshots game={featured} row />}
      <div class="platforms">
        <PlatformLinks game={featured} />
      </div>
    </div>
  </section>

  {
    showcase.length > 0 && (
      <>
        <div class="section showcase-head">
          <div class="wrap section-head">
            <span class="eyebrow">Legends of the seal</span>
            <h2>Battles already won</h2>
          </div>
        </div>
        {showcase.map((game, i) => (
          <Showcase game={game} numeral={NUMERALS[i]} flip={i % 2 === 1} />
        ))}
      </>
    )
  }

  <section class="section games" id="games">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Our games</span>
        <h2>The Hall of Glory</h2>
      </div>
      <div class="grid-games">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="section manifesto" id="about">
    <div class="watermark" aria-hidden="true">Brain Seal</div>
    <div class="wrap grid">
      <div class="section-head">
        <span class="eyebrow">The studio</span>
        <h2>Small Studio.<br /><em>Big Adventures.</em></h2>
      </div>
      <div class="copy">
        <StudioStory />
      </div>
    </div>
  </section>
</Base>

<style>
  .featured {
    padding-top: clamp(16px, 3vw, 40px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .pitch {
    display: grid;
    justify-items: start;
  }
  .pitch h2 {
    margin: 0 0 18px;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    text-transform: uppercase;
  }
  .pitch p {
    color: #d8cfc1;
  }
  .logline {
    margin: clamp(8px, 2vw, 20px) 0 clamp(16px, 2.5vw, 24px);
  }
  .platforms {
    margin-top: clamp(20px, 3vw, 32px);
  }
  .platforms :global(.platform-links) {
    justify-content: center;
  }
  .games {
    border-top: 1px solid var(--line);
  }
  .showcase-head {
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .showcase-head .section-head {
    margin-bottom: 0;
  }
  .manifesto {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background:
      radial-gradient(ellipse 50% 70% at 85% 50%, rgb(212 162 76 / 0.1), transparent 70%),
      var(--ink-2);
  }
  .watermark {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(5rem, 19vw, 17rem);
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(212 162 76 / 0.09);
    pointer-events: none;
    user-select: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .manifesto h2 em {
    font-style: normal;
    color: var(--gold);
  }
  .copy {
    color: #d8cfc1;
    padding-top: 6px;
  }
  .grid-games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 42vw), 1fr));
    gap: clamp(20px, 3vw, 36px) clamp(14px, 2.5vw, 32px);
  }
  @media (max-width: 960px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
